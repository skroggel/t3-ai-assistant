plugin.tx_aiassistant {
    view {
        # cat=plugin.tx_aiassistant/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:ai_assistant/Resources/Private/Templates/
        # cat=plugin.tx_aiassistant/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:ai_assistant/Resources/Private/Partials/
        # cat=plugin.tx_aiassistant/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:ai_assistant/Resources/Private/Layouts/
    }
    persistence {
        # cat=plugin.tx_aiassistant//a; type=string; label=Default storage PID
        storagePid =
    }
    settings {

    }
}

module.tx_aiassistant {
    view {
        # cat=module.tx_aiassistant/file; type=string; label=Path to template root (BE)
        templateRootPath = EXT:ai_assistant/Resources/Private/Backend/Templates/
        # cat=module.tx_aiassistant/file; type=string; label=Path to template partials (BE)
        partialRootPath = EXT:ai_assistant/Resources/Private/Backend/Partials/
        # cat=module.tx_aiassistant/file; type=string; label=Path to template layouts (BE)
        layoutRootPath = EXT:ai_assistant/Resources/Private/Backend/Layouts/
    }
    persistence {
        # cat=module.tx_aiassistant//a; type=string; label=Default storage PID
        storagePid =
    }
}
