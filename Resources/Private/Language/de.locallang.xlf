<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<xliff version="1.0">
	<file source-language="en" target-language="de" datatype="plaintext" original="EXT:ai_assistant/Resources/Private/Language/locallang.xlf" date="2026-03-24T00:00:00Z" product-name="ai_assistant">
		<header/>
		<body>
			<trans-unit id="templates_index_index.lang" resname="templates_index_index.lang">
				<source>en</source>
				<target>de</target>
			</trans-unit>
			<trans-unit id="templates_index_index.title" resname="templates_index_index.title">
				<source>ChatGPT Example with SSE</source>
				<target>ChatGPT-Beispiel mit SSE</target>
			</trans-unit>
			<trans-unit id="templates_index_index.brand" resname="templates_index_index.brand">
				<source>madj2k Assistant</source>
				<target>madj2k-Assistent</target>
			</trans-unit>
			<trans-unit id="templates_index_index.intro" resname="templates_index_index.intro">
				<source>Ask about the website content or just start a short conversation.</source>
				<target>Fragen Sie nach Inhalten der Website oder starten Sie einfach eine kurze Unterhaltung.</target>
			</trans-unit>
			<trans-unit id="templates_index_index.initial_message" resname="templates_index_index.initial_message">
				<source>Hello, I am your AI-Assistant. How can I help you?</source>
				<target>Hallo, ich bin Ihr KI-Assistent. Wie kann ich Ihnen helfen?</target>
			</trans-unit>
			<trans-unit id="templates_index_index.consent_message" resname="templates_index_index.consent_message">
				<source>Please note: This chat uses artificial intelligence. AI-generated answers can be incorrect. Please review important information carefully.</source>
				<target>Bitte beachten: Dieser Chat verwendet künstliche Intelligenz. KI-generierte Antworten können fehlerhaft sein. Prüfen Sie wichtige Informationen daher sorgfältig.</target>
			</trans-unit>
			<trans-unit id="templates_index_index.consent_button" resname="templates_index_index.consent_button">
				<source>I understand, start chat</source>
				<target>Verstanden, Chat starten</target>
			</trans-unit>
			<trans-unit id="chat.recommendation.line" resname="chat.recommendation.line">
				<source>I found a matching page for you here: %s (%s)</source>
				<target>Ich habe hier einen passenden Inhalt für Sie gefunden: %s (%s)</target>
			</trans-unit>
			<trans-unit id="chat.recommendation.line_without_reference" resname="chat.recommendation.line_without_reference">
				<source>I found a matching page for you here: %s</source>
				<target>Ich habe hier einen passenden Inhalt für Sie gefunden: %s</target>
			</trans-unit>
			<trans-unit id="chat.recommendation.url" resname="chat.recommendation.url">
				<source>Link: %s</source>
				<target>Link: %s</target>
			</trans-unit>
			<trans-unit id="chat.recommendation.reason" resname="chat.recommendation.reason">
				<source>This fits your request well: %s</source>
				<target>Das passt gut zu Ihrer Anfrage: %s</target>
			</trans-unit>
			<trans-unit id="chat.contact.department" resname="chat.contact.department">
				<source>Responsible area: %s</source>
				<target>Zuständiger Bereich: %s</target>
			</trans-unit>
			<trans-unit id="chat.contact.name" resname="chat.contact.name">
				<source>Contact person: %s</source>
				<target>Ansprechpartner: %s</target>
			</trans-unit>
			<trans-unit id="chat.contact.phone" resname="chat.contact.phone">
				<source>Phone: %s</source>
				<target>Telefon: %s</target>
			</trans-unit>
			<trans-unit id="chat.contact.email" resname="chat.contact.email">
				<source>Email: %s</source>
				<target>E-Mail: %s</target>
			</trans-unit>
			<trans-unit id="templates_index_index.input_placeholder" resname="templates_index_index.input_placeholder">
				<source>Your message...</source>
				<target>Ihre Nachricht...</target>
			</trans-unit>
			<trans-unit id="templates_index_index.input_aria_label" resname="templates_index_index.input_aria_label">
				<source>Enter message</source>
				<target>Nachricht eingeben</target>
			</trans-unit>
			<trans-unit id="templates_index_index.submit" resname="templates_index_index.submit">
				<source>Send</source>
				<target>Senden</target>
			</trans-unit>
			<trans-unit id="templates_index_index.response_language" resname="templates_index_index.response_language">
				<source>Response language</source>
				<target>Antwortsprache</target>
			</trans-unit>
			<trans-unit id="templates_index_index.response_language_placeholder" resname="templates_index_index.response_language_placeholder">
				<source>Aa / العربية / 文 / Я</source>
				<target>Aa / العربية / 文 / Я</target>
				</trans-unit>
			<trans-unit id="templates_index_index.response_language_help" resname="templates_index_index.response_language_help">
				<source>Choose a suggestion or enter any language in your own script. Leave empty to use the website language.</source>
				<target>Wählen Sie einen Vorschlag oder geben Sie eine beliebige Sprache in Ihrer eigenen Schrift ein. Leer lassen, um die Sprache der Website zu verwenden.</target>
				</trans-unit>
			<trans-unit id="templates_index_index.use_browser_language" resname="templates_index_index.use_browser_language">
				<source>Use browser language</source>
				<target>Browsersprache verwenden</target>
			</trans-unit>
			<trans-unit id="templates_index_index.use_site_language" resname="templates_index_index.use_site_language">
				<source>Use website language</source>
				<target>Sprache der Website verwenden</target>
			</trans-unit>
			<trans-unit id="templates_index_index.apply_language" resname="templates_index_index.apply_language">
				<source>Use selected language</source>
				<target>Ausgewählte Sprache verwenden</target>
			</trans-unit>
			<trans-unit id="templates_index_index.chat_history" resname="templates_index_index.chat_history">
				<source>Chat history</source>
				<target>Chatverlauf</target>
			</trans-unit>
			<trans-unit id="templates_index_index.user_label" resname="templates_index_index.user_label">
				<source>User message</source>
				<target>Nutzendeneingabe</target>
			</trans-unit>
			<trans-unit id="templates_index_index.assistant_label" resname="templates_index_index.assistant_label">
				<source>AI assistant</source>
				<target>KI-Assistent</target>
			</trans-unit>
			<trans-unit id="templates_index_index.loading" resname="templates_index_index.loading">
				<source>AI assistant is preparing an answer.</source>
				<target>Der KI-Assistent bereitet eine Antwort vor.</target>
			</trans-unit>
			<trans-unit id="templates_index_index.error_message" resname="templates_index_index.error_message">
				<source>The answer could not be loaded.</source>
				<target>Die Antwort konnte nicht geladen werden.</target>
			</trans-unit>
			<trans-unit id="templates_index_index.error_suffix" resname="templates_index_index.error_suffix">
				<source>[Error while loading answer.]</source>
				<target>[Fehler beim Laden der Antwort.]</target>
			</trans-unit>
		</body>
	</file>
</xliff>
