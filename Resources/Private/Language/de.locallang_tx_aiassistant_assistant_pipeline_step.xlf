			<trans-unit id="tx_aiassistant_assistant_pipeline_step.assistant_profile.description" resname="tx_aiassistant_assistant_pipeline_step.assistant_profile.description">
				<source>Selects the assistant profile this pipeline step belongs to. The assistant profile provides the prompt blocks, connections and collection used during execution.</source>
				<target>Wählt das Assistentenprofil aus, zu dem dieser Pipeline-Schritt gehört. Das Assistentenprofil stellt die während der Ausführung verwendeten Prompt-Blöcke, Verbindungen und die Collection bereit.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.title.description" resname="tx_aiassistant_assistant_pipeline_step.title.description">
				<source>Defines the title of this pipeline step. Retriever titles must be unique and are shown in prompts as the retrieval name.</source>
				<target>Definiert den Titel dieses Pipeline-Schritts. Retriever-Titel müssen eindeutig sein und werden in Prompts als Retrieval-Name angezeigt.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.type.description" resname="tx_aiassistant_assistant_pipeline_step.type.description">
				<source>Defines the semantic role of this step in the assistant pipeline, such as query optimization, retrieval, answer generation or quality validation.</source>
				<target>Definiert die semantische Rolle dieses Schritts in der Assistenten-Pipeline, zum Beispiel Abfrageoptimierung, Retrieval, Antwortgenerierung oder Qualitätsvalidierung.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.processor_identifier.description" resname="tx_aiassistant_assistant_pipeline_step.processor_identifier.description">
				<source>Selects the registered processor service that executes this step. The processor must support the selected step type.</source>
				<target>Wählt den registrierten Processor-Service aus, der diesen Schritt ausführt. Der Processor muss den ausgewählten Schritttyp unterstützen.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.stage.description" resname="tx_aiassistant_assistant_pipeline_step.stage.description">
				<source>Groups the step into the execution phase of the pipeline. Sorting still controls the order within the selected stage.</source>
				<target>Ordnet den Schritt einer Ausführungsphase der Pipeline zu. Die Sortierung steuert weiterhin die Reihenfolge innerhalb der ausgewählten Phase.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.include_identity_prompt.description" resname="tx_aiassistant_assistant_pipeline_step.include_identity_prompt.description">
				<source>Adds the assistant identity prompt to this step. Use it when the processor needs to know who the assistant is.</source>
				<target>Fügt diesem Schritt den Identitäts-Prompt des Assistenten hinzu. Verwenden Sie ihn, wenn der Prozessor wissen muss, wer der Assistent ist.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.include_behavior_rules.description" resname="tx_aiassistant_assistant_pipeline_step.include_behavior_rules.description">
				<source>Adds the assistant behavior rules to this step. Use it when the processor should follow the assistant-wide behavior policy.</source>
				<target>Fügt diesem Schritt die Verhaltensregeln des Assistenten hinzu. Verwenden Sie sie, wenn der Prozessor den für den gesamten Assistenten geltenden Verhaltensregeln folgen soll.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.include_retrieval_rules.description" resname="tx_aiassistant_assistant_pipeline_step.include_retrieval_rules.description">
				<source>Adds the assistant retrieval rules to this step. Use it for retrieval and context-related processors.</source>
				<target>Fügt diesem Schritt die Retrieval-Regeln des Assistenten hinzu. Verwenden Sie sie für Retrieval- und kontextbezogene Prozessoren.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.include_output_rules.description" resname="tx_aiassistant_assistant_pipeline_step.include_output_rules.description">
				<source>Adds the assistant output rules to this step. Use it when the processor creates or validates user-facing output.</source>
				<target>Fügt diesem Schritt die Ausgaberegeln des Assistenten hinzu. Verwenden Sie sie, wenn der Prozessor benutzerseitige Ausgaben erzeugt oder validiert.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.step_identity.description" resname="tx_aiassistant_assistant_pipeline_step.step_identity.description">
				<source>Adds an optional identity prompt that applies only to this pipeline step.</source>
				<target>Fügt einen optionalen Identitäts-Prompt hinzu, der nur für diesen Pipeline-Schritt gilt.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.step_behavior_rules.description" resname="tx_aiassistant_assistant_pipeline_step.step_behavior_rules.description">
				<source>Adds optional behavior instructions that apply only to this pipeline step.</source>
				<target>Fügt optionale Verhaltensanweisungen hinzu, die nur für diesen Pipeline-Schritt gelten.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.step_retrieval_rules.description" resname="tx_aiassistant_assistant_pipeline_step.step_retrieval_rules.description">
				<source>Adds optional retrieval or context instructions that apply only to this pipeline step.</source>
				<target>Fügt optionale Retrieval- oder Kontextanweisungen hinzu, die nur für diesen Pipeline-Schritt gelten.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.step_output_rules.description" resname="tx_aiassistant_assistant_pipeline_step.step_output_rules.description">
				<source>Adds optional output instructions that apply only to this pipeline step.</source>
				<target>Fügt optionale Ausgabeanweisungen hinzu, die nur für diesen Pipeline-Schritt gelten.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.history_mode.description" resname="tx_aiassistant_assistant_pipeline_step.history_mode.description">
				<source>Controls whether and how previous conversation messages are provided to this step.</source>
				<target>Steuert, ob und wie vorherige Nachrichten der Unterhaltung diesem Schritt bereitgestellt werden.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.history_limit.description" resname="tx_aiassistant_assistant_pipeline_step.history_limit.description">
				<source>Limits how many previous messages are provided when history mode uses the latest messages.</source>
				<target>Begrenzt die Anzahl vorheriger Nachrichten, die bereitgestellt werden, wenn der Verlaufsmodus die letzten Nachrichten verwendet.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.model.description" resname="tx_aiassistant_assistant_pipeline_step.model.description">
				<source>Optional provider-specific model override for this pipeline step. Leave empty to use the default model of the assistant's AI connection. If set, the model must be supported by that connection's provider. Changing the AI connection may invalidate this override.</source>
				<target>Optionaler anbieterspezifischer Modell-Override für diesen Pipeline-Schritt. Leer lassen, um das Standardmodell der AI-Verbindung des Assistenten zu verwenden. Wenn ein Modell eingetragen ist, muss es vom Anbieter dieser Verbindung unterstützt werden. Eine Änderung der AI-Verbindung kann diesen Override ungültig machen.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.temperature.description" resname="tx_aiassistant_assistant_pipeline_step.temperature.description">
				<source>Controls the creativity of the AI response for this step. Lower values are more deterministic, higher values are more creative.</source>
				<target>Steuert die Kreativität der AI-Antwort für diesen Schritt. Niedrigere Werte führen zu deterministischeren, höhere Werte zu kreativeren Ergebnissen.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.max_tokens.description" resname="tx_aiassistant_assistant_pipeline_step.max_tokens.description">
				<source>Limits the maximum number of tokens generated by the AI model for this step.</source>
				<target>Begrenzt die maximale Anzahl der Tokens, die das AI-Modell für diesen Schritt erzeugen darf.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.max_retrieval_results.description" resname="tx_aiassistant_assistant_pipeline_step.max_retrieval_results.description">
				<source>Defines how many results this retriever may contribute.</source>
				<target>Legt fest, wie viele Ergebnisse dieser Retriever beitragen darf.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.score_threshold.description" resname="tx_aiassistant_assistant_pipeline_step.score_threshold.description">
				<source>Filters retrieval results by minimum similarity score. Results below this value are ignored.</source>
				<target>Filtert Retrieval-Ergebnisse anhand eines minimalen Ähnlichkeits-Scores. Ergebnisse unterhalb dieses Werts werden ignoriert.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.max_context_chunks.description" resname="tx_aiassistant_assistant_pipeline_step.max_context_chunks.description">
				<source>Limits how many retrieved chunks may be used when building the answer context.</source>
				<target>Begrenzt, wie viele abgerufene Chunks beim Aufbau des Antwortkontexts verwendet werden dürfen.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.max_context_characters.description" resname="tx_aiassistant_assistant_pipeline_step.max_context_characters.description">
				<source>Limits the maximum character length of the generated answer context.</source>
				<target>Begrenzt die maximale Zeichenlänge des erzeugten Antwortkontexts.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.prompt_metadata_fields.description" resname="tx_aiassistant_assistant_pipeline_step.prompt_metadata_fields.description">
				<source>Defines comma-separated metadata fields that may be included in prompts, for example title or url.</source>
				<target>Definiert kommaseparierte Metadatenfelder, die in Prompts aufgenommen werden dürfen, zum Beispiel Titel oder URL.</target>
			</trans-unit>
				<trans-unit id="tx_aiassistant_assistant_pipeline_step.failure_strategy.description" resname="tx_aiassistant_assistant_pipeline_step.failure_strategy.description">
					<source>Defines how the pipeline should continue when this step fails.</source>
					<target>Legt fest, wie die Pipeline fortfahren soll, wenn dieser Schritt fehlschlägt.</target>
				</trans-unit>
			<trans-unit id="tx_aiassistant_assistant_pipeline_step.prompt_metadata_fields.placeholder" resname="tx_aiassistant_assistant_pipeline_step.prompt_metadata_fields.placeholder">
				<source>title,url</source>
				<target>title,url</target>
			</trans-unit>
