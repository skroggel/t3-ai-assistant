				<target>Zusätzliche kommaseparierte Felder im Format `table.field`, die über die Seiten-PID verknüpft werden.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.collection_placeholder" resname="tx_aiassistant_indexer.collection_placeholder">
				<source>e.g. website_content</source>
				<target>z. B. website_content</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.additional_metadata_placeholder" resname="tx_aiassistant_indexer.additional_metadata_placeholder">
