				<target>Menschenlesbarer Name zur Identifizierung dieses Indexers in CLI/Backend.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.title_placeholder" resname="tx_aiassistant_indexer.title_placeholder">
				<source>e.g. Site pages (DE)</source>
				<target>z. B. Site-Seiten (DE)</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.type_desc" resname="tx_aiassistant_indexer.type_desc">
				<source>Choose what this indexer processes: files, pages, or external content.</source>
				<target>Wählen Sie aus, was dieser Indexer verarbeitet: Dateien, Seiten oder externe Inhalte.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.site_identifier_desc" resname="tx_aiassistant_indexer.site_identifier_desc">
				<source>Choose a TYPO3 site that defines `aiAssistant.collection` in its Site Configuration. The indexer writes to that site's collection.</source>
				<target>Wählen Sie eine TYPO3-Site aus, die `aiAssistant.collection` in ihrer Site-Konfiguration definiert. Der Indexer schreibt in die Collection dieser Site.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.connector_uid_desc" resname="tx_aiassistant_indexer.connector_uid_desc">
				<source>Select the external connector that provides the content for this indexer. Connectors can be created in the backend module under Settings &gt; Connectors.</source>
				<target>Wählen Sie den externen Connector aus, der die Inhalte für diesen Indexer bereitstellt. Connectoren können im Backend-Modul unter Einstellungen &gt; Connectoren erstellt werden.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.chunk_size_desc" resname="tx_aiassistant_indexer.chunk_size_desc">
				<source>Chunk size in words. Leave empty to use global defaults.</source>
				<target>Chunk-Größe in Wörtern. Leer lassen, um globale Standardwerte zu verwenden.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.chunk_size_placeholder" resname="tx_aiassistant_indexer.chunk_size_placeholder">
				<source>500</source>
				<target>500</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.chunk_overlap_desc" resname="tx_aiassistant_indexer.chunk_overlap_desc">
				<source>Overlap in words between chunks. Leave empty to use defaults.</source>
				<target>Überlappung in Wörtern zwischen Chunks. Leer lassen, um Standardwerte zu verwenden.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.chunk_overlap_placeholder" resname="tx_aiassistant_indexer.chunk_overlap_placeholder">
				<source>50</source>
				<target>50</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.max_chunks" resname="tx_aiassistant_indexer.max_chunks">
