			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.indexer_identifier_desc" resname="tx_aiassistant_indexer.indexer_identifier_desc">
				<source>Registered indexer service that executes this configuration.</source>
				<target>Registrierter Indexer-Service, der diese Konfiguration ausführt.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.adapter_identifier_desc" resname="tx_aiassistant_indexer.adapter_identifier_desc">
				<source>Registered adapter used by adapter-based indexers to provide indexable documents.</source>
				<target>Registrierter Adapter, der von adapterbasierten Indexern verwendet wird, um indexierbare Dokumente bereitzustellen.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.additional_metadata_desc" resname="tx_aiassistant_indexer.additional_metadata_desc">
				<source>Optional metadata added to all indexed documents. Use key=value lines. For JSON/JSONL files, use json_text_fields.&lt;json.path&gt; for indexed text and json_metadata_fields.&lt;json.path&gt;=&lt;payload_key&gt; for mapped metadata.</source>
				<target>Optionale Metadaten, die allen indexierten Dokumenten hinzugefügt werden. Verwenden Sie Zeilen im Format `key=value`. Für JSON-/JSONL-Dateien verwenden Sie `json_text_fields.&lt;json.path&gt;` für indexierten Text und `json_metadata_fields.&lt;json.path&gt;=&lt;payload_key&gt;` für zugeordnete Metadaten.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.ai_connection_desc" resname="tx_aiassistant_indexer.ai_connection_desc">
				<source>AI connection used to create embeddings for documents indexed by this configuration.</source>
				<target>KI-Verbindung zur Erstellung von Embeddings für Dokumente, die mit dieser Konfiguration indexiert werden.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.vector_store_connection_desc" resname="tx_aiassistant_indexer.vector_store_connection_desc">
				<source>Vector database connection where generated document vectors are stored.</source>
				<target>Vektordatenbank-Verbindung, in der die erzeugten Dokumentvektoren gespeichert werden.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.collection_desc" resname="tx_aiassistant_indexer.collection_desc">
				<source>Target vector database collection for all documents created by this indexer.</source>
				<target>Ziel-Collection der Vektordatenbank für alle von diesem Indexer erstellten Dokumente.</target>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.additional_content_fields_desc" resname="tx_aiassistant_indexer.additional_content_fields_desc">
