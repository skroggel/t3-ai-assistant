        <body>
            <trans-unit id="tx_aiassistant_connection_mcp" resname="tx_aiassistant_connection_mcp">
                <source>MCP Connection</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.title" resname="tx_aiassistant_connection_mcp.title">
                <source>Title</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.identifier" resname="tx_aiassistant_connection_mcp.identifier">
                <source>Identifier</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.transport" resname="tx_aiassistant_connection_mcp.transport">
                <source>Transport</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.transport.streamable_http" resname="tx_aiassistant_connection_mcp.transport.streamable_http">
                <source>Streamable HTTP</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.endpoint" resname="tx_aiassistant_connection_mcp.endpoint">
                <source>Endpoint</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.bearer_token" resname="tx_aiassistant_connection_mcp.bearer_token">
                <source>Bearer Token</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.authentication" resname="tx_aiassistant_connection_mcp.authentication"><source>Authentication</source></trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.authentication.description" resname="tx_aiassistant_connection_mcp.authentication.description">
                <source>Select no authentication, a bearer token or OAuth 2.0 Client Credentials.</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.authentication.none" resname="tx_aiassistant_connection_mcp.authentication.none"><source>None</source></trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.authentication.bearer" resname="tx_aiassistant_connection_mcp.authentication.bearer"><source>Bearer Token</source></trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.authentication.oauth_client_credentials" resname="tx_aiassistant_connection_mcp.authentication.oauth_client_credentials"><source>OAuth 2.0 Client Credentials</source></trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.oauth_token_endpoint" resname="tx_aiassistant_connection_mcp.oauth_token_endpoint"><source>OAuth Token Endpoint</source></trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.oauth_token_endpoint.description" resname="tx_aiassistant_connection_mcp.oauth_token_endpoint.description">
                <source>URL of the OAuth 2.0 token endpoint used to obtain MCP access tokens.</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.oauth_client_id" resname="tx_aiassistant_connection_mcp.oauth_client_id"><source>OAuth Client ID</source></trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.oauth_client_id.description" resname="tx_aiassistant_connection_mcp.oauth_client_id.description">
                <source>Client identifier registered with the OAuth 2.0 authorization server.</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.oauth_client_secret" resname="tx_aiassistant_connection_mcp.oauth_client_secret"><source>OAuth Client Secret</source></trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.oauth_client_secret.description" resname="tx_aiassistant_connection_mcp.oauth_client_secret.description">
                <source>Client secret used to authenticate this server-to-server OAuth 2.0 client.</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.oauth_scope" resname="tx_aiassistant_connection_mcp.oauth_scope"><source>OAuth Scope</source></trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.oauth_scope.description" resname="tx_aiassistant_connection_mcp.oauth_scope.description">
                <source>Optional space-separated scopes requested from the OAuth 2.0 authorization server.</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.timeout" resname="tx_aiassistant_connection_mcp.timeout">
                <source>Timeout</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.max_rounds" resname="tx_aiassistant_connection_mcp.max_rounds">
                <source>Maximum Rounds</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.max_rounds.description" resname="tx_aiassistant_connection_mcp.max_rounds.description">
                <source>Maximum number of tool rounds allowed through this MCP connection during one assistant request.</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.allowed_tools" resname="tx_aiassistant_connection_mcp.allowed_tools">
                <source>Allowed Tools</source>
            </trans-unit>
            <trans-unit id="tx_aiassistant_connection_mcp.allowed_tools.description" resname="tx_aiassistant_connection_mcp.allowed_tools.description">
                <source>Comma- or newline-separated MCP tool names. Leave empty to allow all discovered tools.</source>
            </trans-unit>
