			<trans-unit id="tx_aiassistant_indexer.title_desc" resname="tx_aiassistant_indexer.title_desc">
				<source>Human-readable name to identify this indexer in CLI/BE.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.title_placeholder" resname="tx_aiassistant_indexer.title_placeholder">
				<source>e.g. Site pages (DE)</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.type_desc" resname="tx_aiassistant_indexer.type_desc">
				<source>Choose what this indexer processes: files, pages, or external content.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.site_identifier_desc" resname="tx_aiassistant_indexer.site_identifier_desc">
				<source>Choose a TYPO3 site that defines `aiAssistant.collection` in its Site Configuration. The indexer writes to that site's collection.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.connector_uid_desc" resname="tx_aiassistant_indexer.connector_uid_desc">
				<source>Select the external connector that provides the content for this indexer. Connectors can be created in the backend module under Settings &gt; Connectors.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.chunk_size_desc" resname="tx_aiassistant_indexer.chunk_size_desc">
				<source>Chunk size in words. Leave empty to use global defaults.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.chunk_size_placeholder" resname="tx_aiassistant_indexer.chunk_size_placeholder">
				<source>500</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.chunk_overlap_desc" resname="tx_aiassistant_indexer.chunk_overlap_desc">
				<source>Overlap in words between chunks. Leave empty to use defaults.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.chunk_overlap_placeholder" resname="tx_aiassistant_indexer.chunk_overlap_placeholder">
				<source>50</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.max_chunks" resname="tx_aiassistant_indexer.max_chunks">
				<source>Max chunks</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.max_chunks_desc" resname="tx_aiassistant_indexer.max_chunks_desc">
				<source>Limit total chunks per source to control cost.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.max_chunks_placeholder" resname="tx_aiassistant_indexer.max_chunks_placeholder">
				<source>200</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.min_chunk_chars" resname="tx_aiassistant_indexer.min_chunk_chars">
				<source>Min chunk chars</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.min_chunk_chars_desc" resname="tx_aiassistant_indexer.min_chunk_chars_desc">
				<source>Skip chunks shorter than this length.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.min_chunk_chars_placeholder" resname="tx_aiassistant_indexer.min_chunk_chars_placeholder">
				<source>40</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.import_path_desc" resname="tx_aiassistant_indexer.import_path_desc">
				<source>Enter a TYPO3 FAL folder identifier such as 1:/user_upload/rag/. The number is the storage uid shown in Filelist, followed by the folder path inside that storage. Supported file types depend on the registered adapters, for example PDF, JSON and JSONL.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.include_subfolders_desc" resname="tx_aiassistant_indexer.include_subfolders_desc">
				<source>When enabled, all configured import paths are scanned recursively.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.import_path_placeholder" resname="tx_aiassistant_indexer.import_path_placeholder">
				<source>1:/user_upload/rag</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.page_fields_desc" resname="tx_aiassistant_indexer.page_fields_desc">
				<source>Comma or line separated list of page fields to include.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.root_pages_desc" resname="tx_aiassistant_indexer.root_pages_desc">
				<source>Scope of pages for indexer.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.page_fields_placeholder" resname="tx_aiassistant_indexer.page_fields_placeholder">
				<source>title,subtitle,description,keywords,abstract</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.content_types_desc" resname="tx_aiassistant_indexer.content_types_desc">
				<source>Limit to selected CType values. Leave empty to index all.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.content_types_placeholder" resname="tx_aiassistant_indexer.content_types_placeholder">
				<source>text,textpic,textmedia,bullets</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer.content_fields_desc" resname="tx_aiassistant_indexer.content_fields_desc">
