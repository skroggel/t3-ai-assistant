			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer_connector.download_path_desc" resname="tx_aiassistant_indexer_connector.download_path_desc">
				<source>Required when a product download base URL is set. Enter the path between that base URL and the Shopware product ID, for example `/shop/download`. The product ID is always appended automatically.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer_connector.client_secret_desc" resname="tx_aiassistant_indexer_connector.client_secret_desc">
				<source>OAuth client secret used for the Shopware API. The value is stored, but not shown again in plain text when editing the record.</source>
			</trans-unit>
			<trans-unit id="tx_aiassistant_indexer_connector.verify_tls_desc" resname="tx_aiassistant_indexer_connector.verify_tls_desc">
