{
    "name": "madj2k/ai-assistant",
    "type": "typo3-cms-extension",
    "description": "TYPO3 extension that integrates OpenAI with a Qdrant vector store for chat.",
    "authors": [
		{
			"name": "Maximilian Fäßler",
			"role": "Developer"
		},
        {
            "name": "Steffen Kroggel",
            "role": "Developer"
        }
    ],
    "license": "GPL-2.0-or-later",
    "require": {
        "typo3/cms-core": "^13.4 || ^14.3",
        "hkulekci/qdrant": "^1.0",
        "smalot/pdfparser": "^2.7",
        "openai-php/client": "^0.10"
	},
    "require-dev": {
        "typo3/testing-framework": "^6.8"
    },
    "autoload": {
        "psr-4": {
            "Madj2k\\AiAssistant\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Madj2k\\AiAssistant\\Tests\\": "Tests"
        }
    },
    "replace": {
        "typo3-ter/ai-assistant": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin"
    },
    "scripts": {
        "post-autoload-dump": [
            "TYPO3\\TestingFramework\\Composer\\ExtensionTestEnvironment::prepare"
        ]
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/public",
            "extension-key": "ai_assistant"
        }
    }
}
